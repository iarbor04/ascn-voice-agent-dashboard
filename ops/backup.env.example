# Stable identity used to select this installation's restic snapshots.
BACKUP_SOURCE_ID=ascn-production
BACKUP_OFFSITE_CONFIRMED=YES_I_HAVE_VERIFIED
BACKUP_WORK_DIR=/var/lib/ascn-backup

# PostgreSQL is dumped from the running Compose service through its local socket.
BACKUP_COMPOSE_FILE=/opt/ascn-voice/docker-compose.yml
BACKUP_POSTGRES_SERVICE=postgres
POSTGRES_DB=ascn_voice
POSTGRES_USER=ascn_backup
POSTGRES_PASSWORD=REPLACE_ME

# Primary S3/MinIO storage. Give this host a dedicated ListBucket/GetObject-only key.
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_ALLOW_INSECURE_HTTP=true
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=ascn-recordings
OBJECT_STORAGE_BACKUP_PREFIX=recordings/
OBJECT_STORAGE_ACCESS_KEY_ID=REPLACE_ME
OBJECT_STORAGE_SECRET_ACCESS_KEY=REPLACE_ME

# Transitional source for WAV files created before object storage was enabled.
BACKUP_LEGACY_RECORDINGS_SERVICE=app
BACKUP_LEGACY_RECORDINGS_PATH=/app/legacy-data/recordings

# Durable two-phase upload state (queued WAVs, sidecars and interrupted .part files).
BACKUP_RECORDING_SPOOL_SERVICE=voice-gateway
BACKUP_RECORDING_SPOOL_PATH=/recording-spool

# A different provider/failure domain from the production server and primary objects.
RESTIC_REPOSITORY=s3:https://s3.example.net/ascn-offsite/restic
RESTIC_PASSWORD_FILE=/etc/ascn/restic-password
RESTIC_S3_REGION=us-east-1
RESTIC_S3_ACCESS_KEY_ID=REPLACE_ME
RESTIC_S3_SECRET_ACCESS_KEY=REPLACE_ME

BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=5
BACKUP_KEEP_MONTHLY=12
BACKUP_RESTIC_CHECK_SUBSET=5%
BACKUP_PRUNE_AFTER_FORGET=false

# Must be the same PostgreSQL major as production or newer, present locally,
# and preferably pinned by digest rather than a mutable tag.
BACKUP_RESTORE_POSTGRES_IMAGE=postgres:17.11-alpine
BACKUP_RESTORE_REQUIRED_TABLE=ascn_schema_migrations
