# Порты кабинета, voice gateway и SIP.
ASCN_HOST_PORT=3000
ASCN_VOICE_GATEWAY_PORT=8787
ASCN_SIP_PORT=5060

# Публичный IP сервера. Обязателен, если Asterisk за NAT (в Docker это всегда так):
# без него в SDP уйдёт адрес контейнера и звук в трубке пропадёт.
ASTERISK_EXTERNAL_IP=

# Set these before exposing the dashboard to the internet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
INTERNAL_API_KEY=change-to-a-long-random-value
