# Host bindings. The dashboard, gateway and object API stay on loopback;
# expose them only through an HTTPS reverse proxy.
ASCN_BIND_ADDRESS=127.0.0.1
ASCN_HOST_PORT=3000
ASCN_VOICE_GATEWAY_PORT=8787
ASCN_OBJECT_STORAGE_PORT=9000
ASCN_SIP_PORT=5060

# Public server IP advertised in SIP/SDP.
ASTERISK_EXTERNAL_IP=

# Dashboard administrator. Empty secrets intentionally make Compose fail.
ADMIN_USERNAME=admin@ascn.local
ADMIN_PASSWORD=

# Independent machine-to-machine secrets. Never reuse one value here.
GATEWAY_APP_KEY=
APP_GATEWAY_KEY=
BROWSER_TOKEN_SECRET=
EXTERNAL_CALL_API_KEY=
AMI_PASSWORD=

# Stateful services.
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=
POSTGRES_BACKUP_PASSWORD=
REDIS_ADMIN_PASSWORD=
REDIS_APP_PASSWORD=
REDIS_GATEWAY_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
OBJECT_STORAGE_APP_ACCESS_KEY_ID=
OBJECT_STORAGE_APP_SECRET_ACCESS_KEY=
OBJECT_STORAGE_GATEWAY_ACCESS_KEY_ID=
OBJECT_STORAGE_GATEWAY_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BACKUP_ACCESS_KEY_ID=
OBJECT_STORAGE_BACKUP_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=ascn-recordings

# Only set TRUST_PROXY=true when every public request passes through a trusted
# reverse proxy that overwrites X-Forwarded-For and X-Forwarded-Proto.
TRUST_PROXY=false
ALLOW_PUBLIC_REGISTRATION=false

# Outbound campaign scheduler. Interval is how often the app checks for due
# campaigns; each campaign has its own user-selected interval between calls.
CAMPAIGN_SCHEDULER_ENABLED=true
CAMPAIGN_SCHEDULER_INTERVAL_MS=15000

# For running the app outside Compose:
# DATABASE_URL=postgresql://ascn_app:password@127.0.0.1:5432/ascn_voice
# REDIS_URL=redis://:password@127.0.0.1:6379
# OBJECT_STORAGE_ENDPOINT=https://s3.example.com

# Distributed telephony admission and durable terminal-status delivery.
MAX_BROWSER_SESSIONS=5
MAX_ACTIVE_CALLS=50
CALL_CAPACITY_LEASE_MS=120000
TERMINAL_OUTBOX_INTERVAL_MS=5000
TERMINAL_OUTBOX_CLAIM_MS=600000
TERMINAL_OUTBOX_CONCURRENCY=2
TERMINAL_OUTBOX_DEAD_LETTER_TTL_MS=2592000000

# Direct SIP is disabled unless each exact carrier IP is reserved by an
# administrator for a tenant. JSON maps each tenant ID to exact public IPv4
# addresses verified with that tenant's carrier.
DIRECT_SIP_RESERVATIONS={}
